{
    "purpose": "Supervised polymer degradation model benchmark",
    "validation": "Expanding-window temporal holdout",
    "random_split": false,
    "input_features": [
        "exposure_time_hours",
        "time_squared",
        "material",
        "exposure_condition"
    ],
    "target": "target_degradation",
    "metrics": [
        "R2",
        "MAE",
        "RMSE"
